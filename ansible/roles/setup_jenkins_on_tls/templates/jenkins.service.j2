[Unit]
Description=Jenkins Continuous Integration Server
Requires=network.target
After=network.target
StartLimitBurst=10
StartLimitIntervalSec=10m

[Service]
Type=notify
PrivateTmp=yes
NotifyAccess=main
ExecStart=/usr/bin/jenkins
Restart=always
RestartSec=30
SuccessExitStatus=143
User=jenkins
Group=jenkins
Environment="JENKINS_HOME=/var/lib/jenkins"
WorkingDirectory=/var/lib/jenkins
Environment="JAVA_OPTS=-Xms256m -Xmx512m -Djava.io.tmpdir=/var/lib/jenkins/temp -Djava.awt.headless=true -Djenkins.install.runSetupWizard=false -Dconfiguration-as-code -Djava.util.logging.config.file=/etc/jenkins/log.properties"
Environment="JENKINS_HTTPS_PORT=8443"
Environment="JENKINS_DEBUG_LEVEL=5"
EnvironmentFile=/etc/jenkins/jenkins.env
TimeoutStartSec=300
RemoveIPC=yes
NoNewPrivileges=true
PrivateDevices=true
ProtectClock=true
ProtectKernelLogs=true
ProtectSystem=true
ProtectHome=yes


[Install]
WantedBy=multi-user.target
