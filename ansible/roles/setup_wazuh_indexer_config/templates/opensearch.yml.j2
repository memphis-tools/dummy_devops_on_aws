# network.host: Sets the address of this node for both HTTP and transport traffic.
# The node will bind to this address and use it as its publish address.
# Accepts an IP address or a hostname.
network.host: "aws-dummy-ops-wazuh-indexer.lab"
#network.host: "0.0.0.0"
# node.name: "node-1"
node.name: "aws-dummy-ops-wazuh-indexer.lab"
cluster.initial_master_nodes:
- "aws-dummy-ops-wazuh-indexer.lab"
#- "node-2"
#- "node-3"
cluster.name: "wazuh-cluster"
#discovery.seed_hosts:
#  - "node-1-ip"
#  - "node-2-ip"
#  - "node-3-ip"
node.max_local_storage_nodes: "3"
path.data: /var/lib/wazuh-indexer
path.logs: /var/log/wazuh-indexer

plugins.security.ssl.http.pemcert_filepath: /etc/wazuh-indexer/certs/aws_dummy_ops_wazuh_indexer.crt
plugins.security.ssl.http.pemkey_filepath: /etc/wazuh-indexer/certs/aws_dummy_ops_wazuh_indexer.key
plugins.security.ssl.http.pemtrustedcas_filepath: /etc/wazuh-indexer/certs/aws_dummy_ops_ca.crt
plugins.security.ssl.transport.pemcert_filepath: /etc/wazuh-indexer/certs/aws_dummy_ops_wazuh_indexer.crt
plugins.security.ssl.transport.pemkey_filepath: /etc/wazuh-indexer/certs/aws_dummy_ops_wazuh_indexer.key
plugins.security.ssl.transport.pemtrustedcas_filepath: /etc/wazuh-indexer/certs/aws_dummy_ops_ca.crt
plugins.security.ssl.http.enabled: true
plugins.security.ssl.transport.enforce_hostname_verification: false
plugins.security.ssl.transport.resolve_hostname: false

plugins.security.authcz.admin_dn:
- "EMAILADDRESS=root@localhost,CN=aws-dummy-ops-wazuh-admin.lab,OU=DUMMY_DEV_TEAM,O=DUMMY_OPS_TEAM,ST=IDF,L=PARIS,C=FR"
plugins.security.check_snapshot_restore_write_privileges: true
plugins.security.enable_snapshot_restore_privilege: true

plugins.security.nodes_dn:
- "CN=aws-dummy-ops-wazuh-indexer.lab,OU=DUMMY_DEV_TEAM,O=DUMMY_OPS_TEAM,L=PARIS,C=FR"
#- "CN=node-2,OU=Wazuh,O=Wazuh,L=California,C=US"
#- "CN=node-3,OU=Wazuh,O=Wazuh,L=California,C=US"
plugins.security.restapi.roles_enabled:
- "all_access"
- "security_rest_api_access"

plugins.security.system_indices.enabled: true
plugins.security.system_indices.indices: [".plugins-ml-model", ".plugins-ml-task", ".opendistro-alerting-config", ".opendistro-alerting-alert*", ".opendistro-anomaly-results*", ".opendistro-anomaly-detector*", ".opendistro-anomaly-checkpoints", ".opendistro-anomaly-detection-state", ".opendistro-reports-*", ".opensearch-notifications-*", ".opensearch-notebooks", ".opensearch-observability", ".opendistro-asynchronous-search-response*", ".replication-metadata-store"]

### Option to allow Filebeat-oss 7.10.2 to work ###
compatibility.override_main_response_version: true
